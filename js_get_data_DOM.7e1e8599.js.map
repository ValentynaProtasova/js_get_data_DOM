'use strict';
var elements = document.querySelectorAll('span.population');
var texts = Array.from(elements).map(function(el) {
    return el.textContent.trim();
});
var numb = texts.map(function(el) {
    return Number(el.replace(/,/g, ''));
});
var total = numb.reduce(function(n1, n2) {
    return n1 + n2;
}, 0);
var average = total / numb.length;
document.querySelector('span.total-population').textContent = total.toLocaleString('en-US');
document.querySelector('span.average-population').textContent = average.toLocaleString('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
});

